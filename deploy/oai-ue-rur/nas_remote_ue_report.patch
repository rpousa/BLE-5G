+/* nrlink: Remote UE report (TS 24.501 8.3.19) from a layer-3 UE-to-network relay. The relay's controller encodes the
+ * 5GSM message and sends it here as one UDP datagram, <PDU session ID><5GSM message>, to 127.0.0.1:NAS_RAW5GSM_PORT
+ * (env, default 6620). The NAS task sends it in an integrity-protected, ciphered UL NAS transport (payload container
+ * type N1 SM information) for that PDU session; the Remote UE report response (DL NAS transport) is echoed back to the
+ * last sender as "RSP" <PDU session ID> <5GSM header>. */
+
+static void *raw5gsm_listener(void *arg)
+{
+  UNUSED(arg);
+  const char *e = getenv("NAS_RAW5GSM_PORT");
+  int port = e ? atoi(e) : 6620;
+  int s = socket(AF_INET, SOCK_DGRAM, 0);
+  struct sockaddr_in a = {.sin_family = AF_INET, .sin_port = htons(port)};
+  a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  if (s < 0 || bind(s, (struct sockaddr *)&a, sizeof(a)) < 0) {
+    LOG_E(NAS, "Remote UE report: cannot bind 127.0.0.1:%d\n", port);
+    return NULL;
+  }
+  raw5gsm_sock = s;
+  LOG_I(NAS, "Remote UE report: listening on 127.0.0.1:%d\n", port);
+  while (1) {
+    uint8_t buf[1100];
+    struct sockaddr_in from;
+    socklen_t fl = sizeof(from);
+    int n = recvfrom(s, buf, sizeof(buf), 0, (struct sockaddr *)&from, &fl);
+    if (n < 5 || n - 1 > (int)sizeof(((nas_raw_5gsm_req_t *)0)->data))
+      continue;
+    raw5gsm_peer = from;
+    raw5gsm_have_peer = 1;
+    MessageDef *m = itti_alloc_new_message(TASK_NAS_NRUE, 0, NAS_RAW_5GSM_REQ);
+    nas_raw_5gsm_req_t *r = &NAS_RAW_5GSM_REQ(m);
+    r->pdusession_id = buf[0];
+    r->length = n - 1;
+    memcpy(r->data, buf + 1, n - 1);
+    itti_send_msg_to_task(TASK_NAS_NRUE, 0, m);
+  }
+  return NULL;
+}
+
+static void generateUlNasTransportN1SM(nr_ue_nas_t *nas, as_nas_info_t *out, const nas_raw_5gsm_req_t *r)
+{
+  int size = 7 + 3 + 1 + 2 + r->length + 2 + 16;
+  fgmm_nas_msg_security_protected_t sp_msg = {0};
+  fgs_nas_message_security_header_t *sp_header = &sp_msg.header;
+  sp_header->protocol_discriminator = FGS_MOBILITY_MANAGEMENT_MESSAGE;
+  sp_header->security_header_type = INTEGRITY_PROTECTED_AND_CIPHERED;
+  sp_header->sequence_number = nas->security.nas_count_ul & 0xff;
+  fgmm_nas_message_plain_t *plain = &sp_msg.plain;
+  plain->header = set_mm_header(FGS_UPLINK_NAS_TRANSPORT, PLAIN_5GS_MSG);
+  fgs_uplink_nas_transport_msg *mm_msg = &plain->mm_msg.uplink_nas_transport;
+  mm_msg->payloadcontainertype.iei = 0;
+  mm_msg->payloadcontainertype.type = 1; /* N1 SM information */
+  mm_msg->fgspayloadcontainer.payloadcontainercontents.length = r->length;
+  mm_msg->fgspayloadcontainer.payloadcontainercontents.value = (uint8_t *)r->data;
+  mm_msg->pdusessionid = r->pdusession_id;
+  out->nas_data = malloc_or_fail(size);
+  int hl = nas_protected_security_header_encode(out->nas_data, sp_header, size);
+  out->length = hl + mm_msg_encode(plain, (uint8_t *)(out->nas_data + hl), size - hl);
+
+  nas_stream_cipher_t stream_cipher;
+  uint8_t mac[NAS_INTEGRITY_SIZE];
+  uint8_t buf[out->length - 7];
+  stream_cipher.context = nas->security_container->ciphering_context;
+  stream_cipher.count = nas->security.nas_count_ul;
+  stream_cipher.bearer = 1;
+  stream_cipher.direction = 0;
+  stream_cipher.message = (unsigned char *)(out->nas_data + 7);
+  stream_cipher.blength = (out->length - 7) << 3;
+  stream_compute_encrypt(nas->security_container->ciphering_algorithm, &stream_cipher, buf);
+  memcpy(stream_cipher.message, buf, out->length - 7);
+  stream_cipher.context = nas->security_container->integrity_context;
+  stream_cipher.count = nas->security.nas_count_ul++;
+  stream_cipher.message = (unsigned char *)(out->nas_data + 6);
+  stream_cipher.blength = (out->length - 6) << 3;
+  stream_compute_integrity(nas->security_container->integrity_algorithm, &stream_cipher, mac);
+  for (int i = 0; i < 4; i++)
+    out->nas_data[2 + i] = mac[i];
+}
