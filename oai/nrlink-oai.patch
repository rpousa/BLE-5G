--- a/nfapi/oai_integration/nrlink_gnb.c
+++ b/nfapi/oai_integration/nrlink_gnb.c
@@ -0,0 +1,441 @@
+/*
+ * nrlink gNB side: L1 emulation inside the PNF.
+ *
+ * Enabled with NRLINK_GNB=<bridge ip>:<port>. For every slot the PNF hands to L1, the DL content the
+ * VNF scheduled (SSB/MIB, DCIs, PDSCH transport blocks) is sent as a DL_SLOT message to the gNB bridge,
+ * which transmits it over the gNB board's radio and polls the UE boards. The bridge answers with the
+ * UL items the UEs sent for that slot (PUSCH TBs, UCI, PRACH); they are turned into CRC/RX_DATA/UCI/RACH
+ * indications for the VNF, matched against the slot's UL_TTI.request. The PHY's own UL indications
+ * (it receives nothing over rfsim) are suppressed, see NR_IF_Module.c. Waiting for the bridge paces
+ * the PNF: one slot takes as long as its over-the-air exchange.
+ */
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <poll.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "common/ran_context.h"
+#include "common/utils/LOG/log.h"
+#include "openair1/PHY/defs_gNB.h"
+#include "openair1/PHY/NR_TRANSPORT/nr_transport_proto.h"
+#include "common/utils/utils.h"
+#include "openair2/NR_PHY_INTERFACE/NR_IF_Module.h"
+#include "nfapi_nr_interface_scf.h"
+#include "openair1/PHY/nr_phy_common/inc/nr_phy_common.h"
+#include "nrlink_proto.h"
+#include "nrlink_gnb.h"
+
+int oai_nfapi_nr_rx_data_indication(nfapi_nr_rx_data_indication_t *ind);
+int oai_nfapi_nr_crc_indication(nfapi_nr_crc_indication_t *ind);
+int oai_nfapi_nr_uci_indication(nfapi_nr_uci_indication_t *ind);
+int oai_nfapi_nr_rach_indication(nfapi_nr_rach_indication_t *ind);
+
+static int s_sock = -1;
+static struct sockaddr_in s_bridge;
+static int s_timeout_ms = 300;
+static uint8_t s_tx[NRLINK_MAX_MSG];
+static uint8_t s_rx[NRLINK_MAX_MSG];
+
+bool nrlink_gnb_active(void)
+{
+  return s_sock >= 0;
+}
+
+void nrlink_gnb_init(void)
+{
+  const char *env = getenv("NRLINK_GNB");
+  if (env == NULL || *env == '\0')
+    return;
+  char host[64];
+  int port = 5000;
+  if (sscanf(env, "%63[^:]:%d", host, &port) < 1)
+    AssertFatal(false, "NRLINK_GNB must be <ip>:<port>, got \"%s\"\n", env);
+  const char *t = getenv("NRLINK_TIMEOUT_MS");
+  if (t)
+    s_timeout_ms = atoi(t);
+
+  s_sock = socket(AF_INET, SOCK_DGRAM, 0);
+  AssertFatal(s_sock >= 0, "nrlink socket: %s\n", strerror(errno));
+  int buf = 4 << 20;
+  setsockopt(s_sock, SOL_SOCKET, SO_RCVBUF, &buf, sizeof(buf));
+  struct sockaddr_in local = {.sin_family = AF_INET, .sin_port = htons(port + 100), .sin_addr.s_addr = htonl(INADDR_ANY)};
+  AssertFatal(bind(s_sock, (struct sockaddr *)&local, sizeof(local)) == 0, "nrlink bind: %s\n", strerror(errno));
+  s_bridge = (struct sockaddr_in){.sin_family = AF_INET, .sin_port = htons(port)};
+  AssertFatal(inet_pton(AF_INET, host, &s_bridge.sin_addr) == 1, "bad NRLINK_GNB address %s\n", host);
+  LOG_A(NR_PHY, "nrlink: L1 emulation enabled, bridge %s:%d, local port %d, slot timeout %d ms\n", host, port, port + 100, s_timeout_ms);
+}
+
+/* ---- message building ---- */
+
+typedef struct {
+  uint8_t *buf;
+  size_t len;
+  nrlink_hdr_t *hdr;
+} msg_t;
+
+static void msg_start(msg_t *m, uint8_t type, int sfn, int slot)
+{
+  m->buf = s_tx;
+  m->hdr = (nrlink_hdr_t *)s_tx;
+  *m->hdr = (nrlink_hdr_t){.magic = NRLINK_MAGIC, .type = type, .sfn = sfn, .slot = slot};
+  m->len = sizeof(nrlink_hdr_t);
+}
+
+static void *msg_item(msg_t *m, uint8_t type, size_t len)
+{
+  AssertFatal(m->len + sizeof(nrlink_item_t) + len <= sizeof(s_tx), "nrlink message overflow\n");
+  nrlink_item_t *it = (nrlink_item_t *)(m->buf + m->len);
+  it->type = type;
+  it->len = len;
+  m->len += sizeof(*it);
+  void *body = m->buf + m->len;
+  m->len += len;
+  m->hdr->n_items++;
+  return body;
+}
+
+/* The MIB as the UE PHY will report it, see nr_generate_pbch() and nr_rx_pbch() */
+static void add_ssb(msg_t *m, const PHY_VARS_gNB *gNB, int sfn, int slot, const nfapi_nr_dl_tti_ssb_pdu_rel15_t *ssb)
+{
+  const NR_DL_FRAME_PARMS *fp = &gNB->frame_parms;
+  const uint8_t *pbch_pdu = (const uint8_t *)&ssb->bchPayload;
+  uint32_t pbch_a = 0;
+  for (int i = 0; i < NR_PBCH_PDU_BITS; i++)
+    pbch_a |= ((pbch_pdu[i >> 3] >> (7 - (i & 7))) & 1) << i;
+  const int n_hf = slot < (fp->slots_per_frame >> 1) ? 0 : 1;
+  const int ssb_sc_offset = gNB->gNB_config.ssb_table.ssb_subcarrier_offset.value;
+  pbch_a |= nr_pbch_extra_byte_generation(sfn, n_hf, ssb->SsbBlockIndex, ssb_sc_offset, fp->Lmax) << 24;
+
+  uint32_t rev = 0;
+  for (int i = 0; i < 32; i++)
+    rev |= ((pbch_a >> i) & 1) << (31 - i);
+
+  nrlink_ssb_t *s = msg_item(m, NRLINK_IT_SSB, sizeof(*s));
+  for (int i = 0; i < 3; i++)
+    s->mib[i] = (rev >> ((3 - i) << 3)) & 0xff;
+  s->xtra_byte = pbch_a >> 24;
+  s->ssb_index = ssb->SsbBlockIndex;
+  s->lmax = fp->Lmax;
+  s->cell_id = ssb->PhysCellId;
+  // from the PDU, as nr_common_signal_procedures() does: fp->ssb_start_subcarrier is only set when the L1
+  // processes the SSB, after this hook, so it can still be 0 here (the nrUE then asserts on CORESET0)
+  s->ssb_start_subcarrier = nr_get_ssb_start_sc(gNB->gNB_config.ssb_config.scs_common.value, ssb->ssbOffsetPointA,
+                                                ssb->SsbSubcarrierOffset, fp->freq_range);
+}
+
+static void add_dcis(msg_t *m, const nfapi_nr_dl_tti_pdcch_pdu_rel15_t *pdcch)
+{
+  for (int i = 0; i < pdcch->numDlDci; i++) {
+    const nfapi_nr_dl_dci_pdu_t *dci = &pdcch->dci_pdu[i];
+    const int nbytes = (dci->PayloadSizeBits + 7) / 8;
+    nrlink_dci_t *d = msg_item(m, NRLINK_IT_DCI, sizeof(*d) + nbytes);
+    d->rnti = dci->RNTI;
+    d->cce_index = dci->CceIndex;
+    d->aggregation_level = dci->AggregationLevel;
+    d->nbits = dci->PayloadSizeBits;
+    memcpy(d + 1, dci->Payload, nbytes);
+  }
+}
+
+static void add_tb(msg_t *m, const nfapi_nr_dl_tti_pdsch_pdu_rel15_t *pdsch, const nfapi_nr_tx_data_request_t *tx)
+{
+  const int idx = pdsch->pduIndex;
+  if (idx >= tx->Number_of_PDUs || tx->pdu_list[idx].PDU_index != idx) {
+    LOG_E(NR_PHY, "nrlink: no TX_DATA for PDSCH index %d\n", idx);
+    return;
+  }
+  const nfapi_nr_tx_data_request_tlv_t *tlv = &tx->pdu_list[idx].TLVs[0];
+  const uint8_t *data = tlv->tag == 0 ? (const uint8_t *)tlv->value.direct : (const uint8_t *)tlv->value.ptr;
+  const uint32_t len = pdsch->TBSize[0];
+  nrlink_tb_t *t = msg_item(m, NRLINK_IT_TB, sizeof(*t) + len);
+  t->rnti = pdsch->rnti;
+  t->tb_len = len;
+  memcpy(t + 1, data, len);
+}
+
+/* ---- UL results -> indications ---- */
+
+static const nfapi_nr_ul_tti_request_number_of_pdus_t *find_ul_pdu(const nfapi_nr_ul_tti_request_t *ul, int type, uint16_t rnti, int skip)
+{
+  for (int i = 0; i < ul->n_pdus; i++) {
+    const nfapi_nr_ul_tti_request_number_of_pdus_t *p = &ul->pdus_list[i];
+    if (p->pdu_type != type)
+      continue;
+    if (type == NFAPI_NR_UL_CONFIG_PUSCH_PDU_TYPE && p->pusch_pdu.rnti != rnti)
+      continue;
+    if (type == NFAPI_NR_UL_CONFIG_PUCCH_PDU_TYPE && p->pucch_pdu.rnti != rnti)
+      continue;
+    if (skip-- > 0)
+      continue;
+    return p;
+  }
+  return NULL;
+}
+
+/* copy of pucch_rx.c set_uci_payload(): extract nb_bits LSB-first from *payload into bytes */
+static void take_bits(uint64_t *payload, int nb_bits, uint8_t *out)
+{
+  for (int i = 0; i < (nb_bits + 7) / 8; i++) {
+    int n = nb_bits - 8 * i < 8 ? nb_bits - 8 * i : 8;
+    out[i] = *payload & ((1 << n) - 1);
+    *payload >>= n;
+  }
+}
+
+static void fill_uci(nfapi_nr_uci_t *u, const nfapi_nr_pucch_pdu_t *pucch, const nrlink_uci_t *it)
+{
+  if (pucch->format_type <= 1) {
+    u->pdu_type = NFAPI_NR_UCI_FORMAT_0_1_PDU_TYPE;
+    u->pdu_size = sizeof(nfapi_nr_uci_pucch_pdu_format_0_1_t);
+    nfapi_nr_uci_pucch_pdu_format_0_1_t *p = &u->pucch_pdu_format_0_1;
+    p->pduBitmap = pucch->sr_flag | ((pucch->bit_len_harq > 0) << 1);
+    p->handle = pucch->handle;
+    p->rnti = pucch->rnti;
+    p->pucch_format = pucch->format_type;
+    p->ul_cqi = 255;
+    p->timing_advance = 0xffff;
+    p->rssi = 1000;
+    if (pucch->sr_flag) {
+      p->sr.sr_indication = it && it->n_sr > 0 && it->sr_payload;
+      p->sr.sr_confidence_level = 0;
+    }
+    if (pucch->bit_len_harq > 0) {
+      const int n = pucch->bit_len_harq > 2 ? 2 : pucch->bit_len_harq;
+      p->harq.num_harq = n;
+      p->harq.harq_confidence_level = it == NULL; /* no transmission received: DTX */
+      for (int b = 0; b < n; b++) {
+        /* gNB pucch0 decoding: 1 bit -> list[0] = bit0, 2 bits -> list[0] = bit1, list[1] = bit0; 0 = ACK */
+        int bit = it ? (it->ack_payload >> (n - 1 - b)) & 1 : 0;
+        p->harq.harq_list[b].harq_value = !bit;
+      }
+    }
+  } else {
+    u->pdu_type = NFAPI_NR_UCI_FORMAT_2_3_4_PDU_TYPE;
+    u->pdu_size = sizeof(nfapi_nr_uci_pucch_pdu_format_2_3_4_t);
+    nfapi_nr_uci_pucch_pdu_format_2_3_4_t *p = &u->pucch_pdu_format_2_3_4;
+    uint64_t payload = it ? it->payload : 0;
+    const int crc = it == NULL;
+    p->handle = pucch->handle;
+    p->rnti = pucch->rnti;
+    p->pucch_format = pucch->format_type - 2;
+    p->ul_cqi = 255;
+    p->timing_advance = 0xffff;
+    p->rssi = 1000;
+    p->pduBitmap = 0;
+    if (pucch->bit_len_harq > 0) {
+      p->pduBitmap |= 2;
+      p->harq.harq_crc = crc;
+      p->harq.harq_bit_len = pucch->bit_len_harq;
+      p->harq.harq_payload = calloc((pucch->bit_len_harq + 7) / 8, 1);
+      take_bits(&payload, pucch->bit_len_harq, p->harq.harq_payload);
+    }
+    if (pucch->sr_flag) {
+      p->pduBitmap |= 1;
+      p->sr.sr_bit_len = 1;
+      p->sr.sr_payload = malloc(1);
+      p->sr.sr_payload[0] = payload & 1;
+      payload >>= 1;
+    }
+    if (pucch->bit_len_csi_part1 > 0) {
+      p->pduBitmap |= 4;
+      p->csi_part1.csi_part1_crc = crc;
+      p->csi_part1.csi_part1_bit_len = pucch->bit_len_csi_part1;
+      p->csi_part1.csi_part1_payload = calloc((pucch->bit_len_csi_part1 + 7) / 8, 1);
+      take_bits(&payload, pucch->bit_len_csi_part1, p->csi_part1.csi_part1_payload);
+    }
+  }
+}
+
+static const nrlink_uci_t *find_uci(const uint8_t *items, int n_items, size_t len, uint16_t rnti)
+{
+  const uint8_t *p = items;
+  for (int i = 0; i < n_items && p + sizeof(nrlink_item_t) <= items + len; i++) {
+    const nrlink_item_t *it = (const nrlink_item_t *)p;
+    if (it->type == NRLINK_IT_UCI && ((const nrlink_uci_t *)(it + 1))->rnti == rnti)
+      return (const nrlink_uci_t *)(it + 1);
+    p += sizeof(*it) + it->len;
+  }
+  return NULL;
+}
+
+static void indicate(int sfn, int slot, const nfapi_nr_ul_tti_request_t *ul, const uint8_t *items, int n_items, size_t len)
+{
+  static nfapi_nr_crc_indication_t crc_ind;
+  static nfapi_nr_rx_data_indication_t rx_ind;
+  static nfapi_nr_uci_indication_t uci_ind;
+  static nfapi_nr_rach_indication_t rach_ind;
+  static nfapi_nr_crc_t crc_list[NFAPI_MAX_NUM_UL_PDU];
+  static nfapi_nr_rx_data_pdu_t rx_list[NFAPI_MAX_NUM_UL_PDU];
+  static nfapi_nr_uci_t uci_list[NFAPI_MAX_NUM_UL_PDU];
+  static nfapi_nr_prach_indication_pdu_t rach_list[8];
+  bool pusch_done[NFAPI_MAX_NUM_UL_PDU] = {0};
+  bool pucch_done[NFAPI_MAX_NUM_UL_PDU] = {0};
+
+  crc_ind = (nfapi_nr_crc_indication_t){.sfn = sfn, .slot = slot, .crc_list = crc_list};
+  rx_ind = (nfapi_nr_rx_data_indication_t){.sfn = sfn, .slot = slot, .pdu_list = rx_list};
+  uci_ind = (nfapi_nr_uci_indication_t){.sfn = sfn, .slot = slot, .uci_list = uci_list};
+  rach_ind = (nfapi_nr_rach_indication_t){.sfn = sfn, .slot = slot, .pdu_list = rach_list};
+
+  const uint8_t *p = items;
+  for (int i = 0; i < n_items && p + sizeof(nrlink_item_t) <= items + len; i++) {
+    const nrlink_item_t *it = (const nrlink_item_t *)p;
+    const void *body = it + 1;
+    p += sizeof(*it) + it->len;
+    if (it->type == NRLINK_IT_PUSCH) {
+      const nrlink_pusch_t *pu = body;
+      const nfapi_nr_ul_tti_request_number_of_pdus_t *up = find_ul_pdu(ul, NFAPI_NR_UL_CONFIG_PUSCH_PDU_TYPE, pu->rnti, 0);
+      if (!up) {
+        LOG_W(NR_PHY, "nrlink: %d.%d PUSCH from rnti %04x not scheduled\n", sfn, slot, pu->rnti);
+        continue;
+      }
+      const nfapi_nr_pusch_pdu_t *pdu = &up->pusch_pdu;
+      pusch_done[up - ul->pdus_list] = true;
+      const bool ok = pu->tb_len == pdu->pusch_data.tb_size;
+      if (!ok)
+        LOG_W(NR_PHY, "nrlink: %d.%d PUSCH rnti %04x TB %d B, expected %d B\n", sfn, slot, pu->rnti, pu->tb_len, pdu->pusch_data.tb_size);
+      crc_list[crc_ind.number_crcs++] = (nfapi_nr_crc_t){.handle = pdu->handle,
+                                                          .rnti = pdu->rnti,
+                                                          .harq_id = pdu->pusch_data.harq_process_id,
+                                                          .tb_crc_status = !ok,
+                                                          .num_cb = pdu->pusch_data.num_cb,
+                                                          .ul_cqi = 255,
+                                                          .timing_advance = 31,
+                                                          .rssi = 1000};
+      rx_list[rx_ind.number_of_pdus++] = (nfapi_nr_rx_data_pdu_t){.handle = pdu->handle,
+                                                                   .rnti = pdu->rnti,
+                                                                   .harq_id = pdu->pusch_data.harq_process_id,
+                                                                   .pdu_length = ok ? pdu->pusch_data.tb_size : 0,
+                                                                   .ul_cqi = 255,
+                                                                   .timing_advance = 31,
+                                                                   .rssi = 1000,
+                                                                   .pdu = ok ? (uint8_t *)(pu + 1) : NULL};
+    } else if (it->type == NRLINK_IT_UCI) {
+      const nrlink_uci_t *uc = body;
+      for (int k = 0;; k++) {
+        const nfapi_nr_ul_tti_request_number_of_pdus_t *up = find_ul_pdu(ul, NFAPI_NR_UL_CONFIG_PUCCH_PDU_TYPE, uc->rnti, k);
+        if (!up)
+          break;
+        if (pucch_done[up - ul->pdus_list])
+          continue;
+        pucch_done[up - ul->pdus_list] = true;
+        fill_uci(&uci_list[uci_ind.num_ucis++], &up->pucch_pdu, uc);
+      }
+    } else if (it->type == NRLINK_IT_PRACH) {
+      const nrlink_prach_t *pr = body;
+      if (!ul->rach_present && !find_ul_pdu(ul, NFAPI_NR_UL_CONFIG_PRACH_PDU_TYPE, 0, 0)) {
+        LOG_W(NR_PHY, "nrlink: %d.%d PRACH outside of a RACH occasion\n", sfn, slot);
+        continue;
+      }
+      if (rach_ind.number_of_pdus >= sizeofArray(rach_list))
+        continue;
+      nfapi_nr_prach_indication_pdu_t *ind = &rach_ind.pdu_list[rach_ind.number_of_pdus++];
+      *ind = (nfapi_nr_prach_indication_pdu_t){
+          .phy_cell_id = RC.gNB[0]->gNB_config.cell_config.phy_cell_id.value,
+          .symbol_index = pr->start_symbol,
+          .slot_index = slot,
+          .freq_index = pr->num_ra,
+          .avg_rssi = 200,
+          .avg_snr = 0xff,
+          .num_preamble = 1,
+          .preamble_list = {{.preamble_index = pr->preamble_index, .timing_advance = 0, .preamble_pwr = 0xffffffff}}};
+      LOG_I(NR_PHY, "nrlink: %d.%d PRACH preamble %d (symbol %d, fdm %d)\n", sfn, slot, pr->preamble_index, pr->start_symbol, pr->num_ra);
+    }
+  }
+
+  /* scheduled but nothing received over the air: what the PHY reports for a missed transmission */
+  for (int i = 0; i < ul->n_pdus; i++) {
+    const nfapi_nr_ul_tti_request_number_of_pdus_t *up = &ul->pdus_list[i];
+    if (up->pdu_type == NFAPI_NR_UL_CONFIG_PUSCH_PDU_TYPE && !pusch_done[i]) {
+      const nfapi_nr_pusch_pdu_t *pdu = &up->pusch_pdu;
+      crc_list[crc_ind.number_crcs++] = (nfapi_nr_crc_t){.handle = pdu->handle,
+                                                          .rnti = pdu->rnti,
+                                                          .harq_id = pdu->pusch_data.harq_process_id,
+                                                          .tb_crc_status = 1,
+                                                          .num_cb = pdu->pusch_data.num_cb,
+                                                          .ul_cqi = 0,
+                                                          .timing_advance = 31};
+      rx_list[rx_ind.number_of_pdus++] =
+          (nfapi_nr_rx_data_pdu_t){.handle = pdu->handle, .rnti = pdu->rnti, .harq_id = pdu->pusch_data.harq_process_id};
+    } else if (up->pdu_type == NFAPI_NR_UL_CONFIG_PUCCH_PDU_TYPE && !pucch_done[i]) {
+      fill_uci(&uci_list[uci_ind.num_ucis++], &up->pucch_pdu, find_uci(items, n_items, len, up->pucch_pdu.rnti));
+    }
+  }
+
+  if (rach_ind.number_of_pdus)
+    oai_nfapi_nr_rach_indication(&rach_ind);
+  if (uci_ind.num_ucis)
+    oai_nfapi_nr_uci_indication(&uci_ind);
+  if (crc_ind.number_crcs) {
+    oai_nfapi_nr_crc_indication(&crc_ind);
+    oai_nfapi_nr_rx_data_indication(&rx_ind);
+  }
+}
+
+static int now_ms(void)
+{
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+void nrlink_gnb_slot(int sfn, int slot, struct NR_Sched_Rsp *rsp)
+{
+  const PHY_VARS_gNB *gNB = RC.gNB[0];
+  msg_t m;
+  msg_start(&m, NRLINK_MSG_DL_SLOT, sfn, slot);
+
+  const nfapi_nr_dl_tti_request_body_t *dl = &rsp->DL_req.dl_tti_request_body;
+  for (int i = 0; i < dl->nPDUs; i++) {
+    const nfapi_nr_dl_tti_request_pdu_t *pdu = &dl->dl_tti_pdu_list[i];
+    if (pdu->PDUType == NFAPI_NR_DL_TTI_SSB_PDU_TYPE)
+      add_ssb(&m, gNB, sfn, slot, &pdu->ssb_pdu.ssb_pdu_rel15);
+    else if (pdu->PDUType == NFAPI_NR_DL_TTI_PDCCH_PDU_TYPE)
+      add_dcis(&m, &pdu->pdcch_pdu.pdcch_pdu_rel15);
+  }
+  for (int i = 0; i < rsp->UL_dci_req.numPdus; i++)
+    add_dcis(&m, &rsp->UL_dci_req.ul_dci_pdu_list[i].pdcch_pdu.pdcch_pdu_rel15);
+  for (int i = 0; i < dl->nPDUs; i++) {
+    const nfapi_nr_dl_tti_request_pdu_t *pdu = &dl->dl_tti_pdu_list[i];
+    if (pdu->PDUType == NFAPI_NR_DL_TTI_PDSCH_PDU_TYPE)
+      add_tb(&m, &pdu->pdsch_pdu.pdsch_pdu_rel15, &rsp->TX_req);
+  }
+  const nfapi_nr_ul_tti_request_t *ul = &rsp->UL_tti_req;
+  for (int i = 0; i < ul->n_pdus; i++) {
+    if (ul->pdus_list[i].pdu_type == NFAPI_NR_UL_CONFIG_PUSCH_PDU_TYPE) {
+      nrlink_ulgrant_t *g = msg_item(&m, NRLINK_IT_ULGRANT, sizeof(*g));
+      g->rnti = ul->pdus_list[i].pusch_pdu.rnti;
+      g->tb_len = ul->pdus_list[i].pusch_pdu.pusch_data.tb_size;
+    }
+  }
+  if (ul->n_pdus > 0)
+    m.hdr->flags |= NRLINK_FLAG_UL_POLL;
+
+  sendto(s_sock, m.buf, m.len, 0, (struct sockaddr *)&s_bridge, sizeof(s_bridge));
+
+  /* wait for the bridge to finish the slot's over-the-air exchange */
+  const int deadline = now_ms() + s_timeout_ms;
+  for (;;) {
+    int left = deadline - now_ms();
+    if (left <= 0) {
+      LOG_W(NR_PHY, "nrlink: %d.%d no answer from the bridge\n", sfn, slot);
+      indicate(sfn, slot, ul, NULL, 0, 0);
+      return;
+    }
+    struct pollfd pfd = {.fd = s_sock, .events = POLLIN};
+    if (poll(&pfd, 1, left) <= 0)
+      continue;
+    ssize_t n = recv(s_sock, s_rx, sizeof(s_rx), 0);
+    if (n < (ssize_t)sizeof(nrlink_hdr_t))
+      continue;
+    const nrlink_hdr_t *h = (const nrlink_hdr_t *)s_rx;
+    if (h->magic != NRLINK_MAGIC || h->type != NRLINK_MSG_UL_RESULT || h->sfn != sfn || h->slot != slot)
+      continue; /* stale answer for an earlier, timed out slot */
+    indicate(sfn, slot, ul, s_rx + sizeof(*h), h->n_items, n - sizeof(*h));
+    return;
+  }
+}
