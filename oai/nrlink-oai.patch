+/*
+ * nrlink UE side: L1 emulation replacing UE_thread (see nfapi/oai_integration/nrlink_proto.h).
+ *
+ * Enabled with NRLINK_UE=<bridge ip>:<port>. The UE bridge forwards the DL_SLOT messages its board
+ * received over the air; each one drives one slot of the UE MAC exactly as the PHY would:
+ * MIB (SSB), DCIs matched against the search spaces the MAC configured, PDSCH transport blocks for the
+ * DLSCH the MAC configured from those DCIs. For the TX slot (rx slot + rx2tx) the MAC's PUSCH/PUCCH/PRACH
+ * configuration is sent back as an UL_SLOT message, which the bridge transmits when the gNB polls.
+ */
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <poll.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "PHY/defs_nr_common.h"
+#include "PHY/impl_defs_nr.h"
+#include "executables/nr-uesoftmodem.h"
+#include "PHY/INIT/nr_phy_init.h"
+#include "LAYER2/NR_MAC_UE/mac_proto.h"
+#include "RRC/NR_UE/L2_interface_ue.h"
+#include "SCHED_NR_UE/defs.h"
+#include "executables/softmodem-common.h"
+#include "common/utils/nr/nr_common.h"
+#include "common/utils/time_manager/time_manager.h"
+#include "nr_phy_common.h"
+#include "log.h"
+#include "common/utils/utils.h"
+#include "../nfapi/oai_integration/nrlink_proto.h"
+
+#define MAX_SS 16
+#define MAX_DLSCH 8
+#define MAX_CATCHUP_SLOTS 40
+
+/* what the MAC configured for the slot being processed (passed to the MAC as phy_data) */
+typedef struct {
+  int n_ss;
+  fapi_nr_dl_config_dci_dl_pdu_rel15_t ss[MAX_SS];
+  int n_dlsch;
+  struct {
+    uint8_t type;
+    fapi_nr_dl_config_dlsch_pdu pdu;
+  } dlsch[MAX_DLSCH];
+} emu_dl_t;
+
+typedef struct {
+  uint8_t *buf;
+  size_t len;
+  nrlink_hdr_t *hdr;
+} emu_msg_t;
+
+static int s_sock = -1;
+static struct sockaddr_in s_bridge;
+static uint8_t s_rx[NRLINK_MAX_MSG];
+static uint8_t s_tx[NRLINK_MAX_MSG];
+static emu_msg_t *s_ul; /* UL message being built during ul_indication */
+static uint16_t s_crnti;
+
+static void *ul_item(emu_msg_t *m, uint8_t type, size_t len)
+{
+  AssertFatal(m->len + sizeof(nrlink_item_t) + len <= sizeof(s_tx), "nrlink UL message overflow\n");
+  nrlink_item_t *it = (nrlink_item_t *)(m->buf + m->len);
+  it->type = type;
+  it->len = len;
+  m->len += sizeof(*it);
+  void *body = m->buf + m->len;
+  m->len += len;
+  m->hdr->n_items++;
+  return body;
+}
+
+/* replaces nr_ue_scheduled_response(): capture the MAC's configuration instead of programming a PHY */
+static int8_t emu_scheduled_response(nr_scheduled_response_t *sr)
+{
+  if (sr->dl_config && sr->phy_data) {
+    emu_dl_t *dl = sr->phy_data;
+    fapi_nr_dl_config_request_t *cfg = sr->dl_config;
+    int n_ss = 0, n_dlsch = 0;
+    for (int i = 0; i < cfg->number_pdus; i++) {
+      fapi_nr_dl_config_request_pdu_t *pdu = &cfg->dl_config_list[i];
+      switch (pdu->pdu_type) {
+        case FAPI_NR_DL_CONFIG_TYPE_DCI:
+          if (n_ss < MAX_SS)
+            dl->ss[n_ss++] = pdu->dci_config_pdu.dci_config_rel15;
+          break;
+        case FAPI_NR_DL_CONFIG_TYPE_DLSCH:
+        case FAPI_NR_DL_CONFIG_TYPE_RA_DLSCH:
+        case FAPI_NR_DL_CONFIG_TYPE_SI_DLSCH:
+        case FAPI_NR_DL_CONFIG_TYPE_P_DLSCH:
+          if (n_dlsch < MAX_DLSCH) {
+            dl->dlsch[n_dlsch].type = pdu->pdu_type;
+            dl->dlsch[n_dlsch].pdu = pdu->dlsch_config_pdu;
+            n_dlsch++;
+          }
+          break;
+        default:
+          break; /* CSI-RS/IM, TA command: nothing to emulate */
+      }
+    }
+    if (n_ss)
+      dl->n_ss = n_ss;
+    if (n_dlsch)
+      dl->n_dlsch = n_dlsch;
+  }
+
+  if (sr->ul_config) {
+    fapi_nr_ul_config_request_t *cfg = sr->ul_config;
+    fapi_nr_ul_config_request_pdu_t *pdu = fapiLockIterator(cfg, cfg->frame, cfg->slot);
+    if (!pdu)
+      return 0;
+    for (; pdu->pdu_type != FAPI_NR_END; pdu++) {
+      switch (pdu->pdu_type) {
+        case FAPI_NR_UL_CONFIG_TYPE_PUSCH: {
+          const nfapi_nr_ue_pusch_pdu_t *p = &pdu->pusch_config_pdu;
+          const uint32_t len = p->tx_request_body.fapiTxPdu ? p->tx_request_body.pdu_length : 0;
+          if (s_ul) {
+            nrlink_pusch_t *it = ul_item(s_ul, NRLINK_IT_PUSCH, sizeof(*it) + len);
+            it->rnti = p->rnti;
+            it->harq_pid = p->pusch_data.harq_process_id;
+            it->tb_len = len;
+            if (len)
+              memcpy(it + 1, p->tx_request_body.fapiTxPdu, len);
+            /* UCI multiplexed on PUSCH is not emulated: the gNB OAI scheduler avoids it by default */
+          }
+          pdu->pdu_type = FAPI_NR_UL_CONFIG_TYPE_DONE;
+        } break;
+        case FAPI_NR_UL_CONFIG_TYPE_PUCCH: {
+          const fapi_nr_ul_config_pucch_pdu *p = &pdu->pucch_config_pdu;
+          if (s_ul) {
+            nrlink_uci_t *it = ul_item(s_ul, NRLINK_IT_UCI, sizeof(*it));
+            *it = (nrlink_uci_t){.rnti = p->rnti,
+                                 .format = p->format_type,
+                                 .n_harq = p->emu_n_harq,
+                                 .ack_payload = p->emu_ack_payload,
+                                 .n_sr = p->emu_n_sr,
+                                 .sr_payload = p->emu_sr_payload,
+                                 .n_bit = p->n_bit,
+                                 .payload = p->payload};
+          }
+          pdu->pdu_type = FAPI_NR_UL_CONFIG_TYPE_DONE;
+        } break;
+        case FAPI_NR_UL_CONFIG_TYPE_PRACH: {
+          const fapi_nr_ul_config_prach_pdu *p = &pdu->prach_config_pdu;
+          if (s_ul) {
+            nrlink_prach_t *it = ul_item(s_ul, NRLINK_IT_PRACH, sizeof(*it));
+            *it = (nrlink_prach_t){.preamble_index = p->ra_PreambleIndex, .num_ra = p->num_ra, .start_symbol = p->prach_start_symbol};
+            LOG_I(NR_PHY, "nrlink: PRACH preamble %d for %d.%d\n", p->ra_PreambleIndex, cfg->frame, cfg->slot);
+          }
+          pdu->pdu_type = FAPI_NR_UL_CONFIG_TYPE_DONE;
+        } break;
+        case FAPI_NR_UL_CONFIG_TYPE_SRS:
+          pdu->pdu_type = FAPI_NR_UL_CONFIG_TYPE_DONE;
+          break;
+        default:
+          break;
+      }
+    }
+    release_ul_config(pdu, true);
+  }
+  return 0;
+}
+
+/* copies of the static helpers in nr-ue.c and phy_procedures_nr_ue.c */
+static int emu_slot_select(const fapi_nr_config_request_t *cfg, int nr_slot)
+{
+  if (cfg->cell_config.frame_duplex_type == FDD)
+    return NR_UPLINK_SLOT | NR_DOWNLINK_SLOT;
+  const fapi_nr_tdd_table_t *tdd_table = &cfg->tdd_table;
+  if (tdd_table->max_tdd_periodicity_list == NULL)
+    return NR_DOWNLINK_SLOT;
+  const fapi_nr_max_tdd_periodicity_t *cur = &tdd_table->max_tdd_periodicity_list[nr_slot % tdd_table->tdd_period_in_slots];
+  if (cur->num_dl_ul_symbols_list.num_dl == NR_SYMBOLS_PER_SLOT)
+    return NR_DOWNLINK_SLOT;
+  if (cur->num_dl_ul_symbols_list.num_ul == NR_SYMBOLS_PER_SLOT)
+    return NR_UPLINK_SLOT;
+  return NR_MIXED_SLOT;
+}
+
+static uint32_t emu_ssb_arfcn(const NR_DL_FRAME_PARMS *fp)
+{
+  uint32_t band_size_hz = fp->N_RB_DL * 12 * fp->subcarrier_spacing;
+  int ssb_center_sc = fp->ssb_start_subcarrier + 120;
+  uint64_t ssb_freq = fp->dl_CarrierFreq - (band_size_hz / 2) + fp->subcarrier_spacing * ssb_center_sc;
+  return to_nrarfcn(ssb_freq);
+}
+
+static bool has_dl(int type)
+{
+  return type == NR_DOWNLINK_SLOT || type == NR_MIXED_SLOT || type == (NR_UPLINK_SLOT | NR_DOWNLINK_SLOT);
+}
+
+static bool has_ul(int type)
+{
+  return type == NR_UPLINK_SLOT || type == NR_MIXED_SLOT || type == (NR_UPLINK_SLOT | NR_DOWNLINK_SLOT);
+}
+
+/* ---- DL slot message parsing ---- */
+
+typedef struct {
+  const nrlink_ssb_t *ssb;
+  int n_dci;
+  const nrlink_dci_t *dci[32];
+  int n_tb;
+  const nrlink_tb_t *tb[32];
+} dl_items_t;
+
+static void parse_dl(const uint8_t *items, int n_items, size_t len, dl_items_t *out)
+{
+  memset(out, 0, sizeof(*out));
+  const uint8_t *p = items;
+  for (int i = 0; i < n_items && p + sizeof(nrlink_item_t) <= items + len; i++) {
+    const nrlink_item_t *it = (const nrlink_item_t *)p;
+    if (p + sizeof(*it) + it->len > items + len)
+      break;
+    const void *body = it + 1;
+    if (it->type == NRLINK_IT_SSB)
+      out->ssb = body;
+    else if (it->type == NRLINK_IT_DCI && out->n_dci < 32)
+      out->dci[out->n_dci++] = body;
+    else if (it->type == NRLINK_IT_TB && out->n_tb < 32)
+      out->tb[out->n_tb++] = body;
+    p += sizeof(*it) + it->len;
+  }
+}
+
+static void deliver_ssb(PHY_VARS_NR_UE *UE, int frame, int slot, const nrlink_ssb_t *s)
+{
+  NR_DL_FRAME_PARMS *fp = &UE->frame_parms;
+  fp->Nid_cell = s->cell_id;
+  fp->ssb_index = s->ssb_index;
+  fp->ssb_start_subcarrier = s->ssb_start_subcarrier;
+
+  fapi_nr_rx_indication_t rx_ind = {.number_pdus = 1};
+  fapi_nr_ssb_pdu_t *ssb = &rx_ind.rx_indication_body[0].ssb_pdu;
+  rx_ind.rx_indication_body[0].pdu_type = FAPI_NR_RX_PDU_TYPE_SSB;
+  memcpy(ssb->pdu, s->mib, 3);
+  ssb->additional_bits = s->xtra_byte;
+  ssb->ssb_index = s->ssb_index & 7;
+  ssb->ssb_length = s->lmax;
+  ssb->cell_id = s->cell_id;
+  ssb->ssb_start_subcarrier = s->ssb_start_subcarrier;
+  ssb->arfcn = emu_ssb_arfcn(fp);
+  ssb->radiolink_monitoring = RLM_in_sync;
+  ssb->decoded_pdu = true;
+  nr_downlink_indication_t dl = {.module_id = UE->Mod_id, .cc_id = UE->CC_id, .frame = frame, .slot = slot, .rx_ind = &rx_ind};
+  UE->if_inst->dl_indication(&dl);
+}
+
+static void deliver_dcis(PHY_VARS_NR_UE *UE, int frame, int slot, const dl_items_t *items, emu_dl_t *cfg)
+{
+  fapi_nr_dci_indication_t dci_ind = {.SFN = frame, .slot = slot};
+  for (int i = 0; i < items->n_dci; i++) {
+    const nrlink_dci_t *d = items->dci[i];
+    bool found = false;
+    for (int s = 0; s < cfg->n_ss && !found; s++) {
+      const fapi_nr_dl_config_dci_dl_pdu_rel15_t *ss = &cfg->ss[s];
+      if (ss->rnti != d->rnti)
+        continue;
+      for (int k = 0; k < ss->num_dci_options && !found; k++) {
+        if (ss->dci_length_options[k] != d->nbits)
+          continue;
+        if (dci_ind.number_of_dcis >= sizeofArray(dci_ind.dci_list))
+          break;
+        fapi_nr_dci_indication_pdu_t *out = &dci_ind.dci_list[dci_ind.number_of_dcis++];
+        *out = (fapi_nr_dci_indication_pdu_t){.rnti = d->rnti,
+                                              .n_CCE = d->cce_index,
+                                              .N_CCE = d->aggregation_level,
+                                              .dci_format = ss->dci_format_options[k],
+                                              .ss_type = ss->ss_type_options[k],
+                                              .coreset_type = ss->coreset.CoreSetType,
+                                              .payloadSize = d->nbits};
+        int n_rb, cset_start;
+        get_coreset_rballoc(ss->coreset.frequency_domain_resource, &n_rb, &cset_start);
+        out->cset_start = ss->BWPStart + cset_start + ss->coreset.rb_offset;
+        memcpy(out->payloadBits, d + 1, (d->nbits + 7) / 8);
+        found = true;
+      }
+    }
+  }
+  if (dci_ind.number_of_dcis == 0)
+    return;
+  cfg->n_dlsch = 0;
+  nr_downlink_indication_t dl = {.module_id = UE->Mod_id, .cc_id = UE->CC_id, .frame = frame, .slot = slot, .dci_ind = &dci_ind, .phy_data = cfg};
+  UE->if_inst->dl_indication(&dl);
+}
+
+static void deliver_pdsch(PHY_VARS_NR_UE *UE, int frame, int slot, const dl_items_t *items, emu_dl_t *cfg)
+{
+  for (int i = 0; i < cfg->n_dlsch; i++) {
+    const fapi_nr_dl_config_dlsch_pdu *pdu = &cfg->dlsch[i].pdu;
+    const fapi_nr_dl_config_dlsch_pdu_rel15_t *rel15 = &pdu->dlsch_config_rel15;
+    const uint32_t tbs = rel15->cw_info[0].TBS / 8;
+    const nrlink_tb_t *tb = NULL;
+    for (int t = 0; t < items->n_tb && !tb; t++)
+      if (items->tb[t]->rnti == pdu->rnti)
+        tb = items->tb[t];
+    uint8_t type = FAPI_NR_RX_PDU_TYPE_DLSCH;
+    if (cfg->dlsch[i].type == FAPI_NR_DL_CONFIG_TYPE_RA_DLSCH)
+      type = FAPI_NR_RX_PDU_TYPE_RAR;
+    else if (cfg->dlsch[i].type == FAPI_NR_DL_CONFIG_TYPE_SI_DLSCH)
+      type = FAPI_NR_RX_PDU_TYPE_SIB;
+    else if (cfg->dlsch[i].type == FAPI_NR_DL_CONFIG_TYPE_P_DLSCH)
+      type = FAPI_NR_RX_PDU_TYPE_PCCH;
+    const bool ok = tb && tb->tb_len == tbs;
+    if (tb && !ok)
+      LOG_W(NR_PHY, "nrlink: %d.%d rnti %04x TB %d B over the air, MAC expects %d B\n", frame, slot, pdu->rnti, tb->tb_len, tbs);
+    fapi_nr_rx_indication_t rx_ind = {.number_pdus = 1};
+    rx_ind.rx_indication_body[0].pdu_type = type;
+    fapi_nr_pdsch_pdu_t *pd = &rx_ind.rx_indication_body[0].pdsch_pdu;
+    pd->harq_pid = rel15->harq_process_nbr;
+    pd->cw_idx = 0;
+    pd->ack_nack = ok;
+    pd->pdu = ok ? (uint8_t *)(tb + 1) : NULL;
+    pd->pdu_length = tbs;
+    nr_downlink_indication_t dl = {.module_id = UE->Mod_id, .cc_id = UE->CC_id, .frame = frame, .slot = slot, .rx_ind = &rx_ind};
+    UE->if_inst->dl_indication(&dl);
+  }
+}
+
+static void drain_rrc(PHY_VARS_NR_UE *UE)
+{
+  NR_UE_MAC_INST_t *mac = get_mac_inst(UE->Mod_id);
+  for (;;) {
+    notifiedFIFO_elt_t *elt = pollNotifiedFIFO(&mac->input_nf);
+    if (!elt)
+      break;
+    process_msg_rcc_to_mac(NotifiedFifoData(elt), UE->Mod_id);
+    delNotifiedFIFO_elt(elt);
+  }
+}
+
+static void process_slot(PHY_VARS_NR_UE *UE, int abs_slot, const dl_items_t *items)
+{
+  const NR_DL_FRAME_PARMS *fp = &UE->frame_parms;
+  const int spf = fp->slots_per_frame;
+  const int rx2tx = get_nrUE_params()->ue_capability_rx2tx;
+  const int frame = (abs_slot / spf) % MAX_FRAME_NUMBER, slot = abs_slot % spf;
+  const int frame_tx = ((abs_slot + rx2tx) / spf) % MAX_FRAME_NUMBER, slot_tx = (abs_slot + rx2tx) % spf;
+  int rx_type = NR_DOWNLINK_SLOT, tx_type = NR_DOWNLINK_SLOT;
+  if (UE->received_config_request) {
+    rx_type = emu_slot_select(&UE->nrUE_config, slot);
+    tx_type = emu_slot_select(&UE->nrUE_config, slot_tx);
+  }
+
+  time_manager_iq_samples(1, spf * 100);
+  drain_rrc(UE);
+  UE->if_inst->slot_indication(UE->Mod_id, false);
+
+  if (has_dl(rx_type)) {
+    static emu_dl_t cfg;
+    memset(&cfg, 0, sizeof(cfg));
+    nr_downlink_indication_t dl = {.module_id = UE->Mod_id, .cc_id = UE->CC_id, .frame = frame, .slot = slot, .phy_data = &cfg};
+    UE->if_inst->dl_indication(&dl); /* MAC configures the search spaces to monitor */
+    if (items) {
+      if (items->ssb)
+        deliver_ssb(UE, frame, slot, items->ssb);
+      deliver_dcis(UE, frame, slot, items, &cfg);
+      deliver_pdsch(UE, frame, slot, items, &cfg);
+    }
+  }
+
+  UE->if_inst->slot_indication(UE->Mod_id, true);
+  if (has_ul(tx_type)) {
+    emu_msg_t m = {.buf = s_tx, .hdr = (nrlink_hdr_t *)s_tx, .len = sizeof(nrlink_hdr_t)};
+    NR_UE_MAC_INST_t *mac = get_mac_inst(UE->Mod_id);
+    s_crnti = mac->crnti;
+    *m.hdr = (nrlink_hdr_t){.magic = NRLINK_MAGIC, .type = NRLINK_MSG_UL_SLOT, .sfn = frame_tx, .slot = slot_tx, .rnti = s_crnti};
+    s_ul = &m;
+    nr_phy_data_tx_t phy_data = {0};
+    nr_uplink_indication_t ul = {.module_id = UE->Mod_id, .frame = frame_tx, .slot = slot_tx, .phy_data = &phy_data};
+    UE->if_inst->ul_indication(&ul);
+    s_ul = NULL;
+    /* sent even when empty: tells the bridge this TX slot is processed, so it does not answer a poll too early */
+    sendto(s_sock, m.buf, m.len, 0, (struct sockaddr *)&s_bridge, sizeof(s_bridge));
+  }
+}
+
+static void send_hello(void)
+{
+  nrlink_hdr_t h = {.magic = NRLINK_MAGIC, .type = NRLINK_MSG_HELLO, .rnti = s_crnti};
+  sendto(s_sock, &h, sizeof(h), 0, (struct sockaddr *)&s_bridge, sizeof(s_bridge));
+}
+
+bool nrlink_ue_enabled(void)
+{
+  const char *env = getenv("NRLINK_UE");
+  return env && *env;
+}
+
+void *nrlink_ue_thread(void *arg)
+{
+  PHY_VARS_NR_UE *UE = arg;
+  const char *env = getenv("NRLINK_UE");
+  char host[64];
+  int port = 5001;
+  AssertFatal(sscanf(env, "%63[^:]:%d", host, &port) >= 1, "NRLINK_UE must be <ip>:<port>\n");
+  s_sock = socket(AF_INET, SOCK_DGRAM, 0);
+  AssertFatal(s_sock >= 0, "nrlink socket: %s\n", strerror(errno));
+  int buf = 4 << 20;
+  setsockopt(s_sock, SOL_SOCKET, SO_RCVBUF, &buf, sizeof(buf));
+  s_bridge = (struct sockaddr_in){.sin_family = AF_INET, .sin_port = htons(port)};
+  AssertFatal(inet_pton(AF_INET, host, &s_bridge.sin_addr) == 1, "bad NRLINK_UE address %s\n", host);
+  UE->if_inst->scheduled_response = emu_scheduled_response;
+  UE->is_synchronized = 0;
+  LOG_A(NR_PHY, "nrlink: UE L1 emulation, bridge %s:%d\n", host, port);
+
+  const int spf = UE->frame_parms.slots_per_frame;
+  const int frame_slots = MAX_FRAME_NUMBER * spf;
+  int last_abs = -1;
+  time_t last_hello = 0;
+  dl_items_t items;
+
+  while (!oai_exit) {
+    if (time(NULL) != last_hello) {
+      send_hello(); /* lets the bridge learn our address and current C-RNTI */
+      last_hello = time(NULL);
+    }
+    struct pollfd pfd = {.fd = s_sock, .events = POLLIN};
+    if (poll(&pfd, 1, 500) <= 0)
+      continue;
+    ssize_t n = recv(s_sock, s_rx, sizeof(s_rx), 0);
+    if (n < (ssize_t)sizeof(nrlink_hdr_t))
+      continue;
+    const nrlink_hdr_t *h = (const nrlink_hdr_t *)s_rx;
+    if (h->magic != NRLINK_MAGIC || h->type != NRLINK_MSG_DL_SLOT)
+      continue;
+    parse_dl(s_rx + sizeof(*h), h->n_items, n - sizeof(*h), &items);
+    const int abs_slot = h->sfn * spf + h->slot;
+
+    if (!UE->is_synchronized) {
+      if (!items.ssb)
+        continue;
+      /* initial sync: MIB to MAC/RRC, then wait for RRC's answer as UE_thread does */
+      deliver_ssb(UE, h->sfn, h->slot, items.ssb);
+      NR_UE_MAC_INST_t *mac = get_mac_inst(UE->Mod_id);
+      notifiedFIFO_elt_t *elt = pullNotifiedFIFO(&mac->input_nf);
+      process_msg_rcc_to_mac(NotifiedFifoData(elt), UE->Mod_id);
+      delNotifiedFIFO_elt(elt);
+      UE->is_synchronized = 1;
+      LOG_A(NR_PHY, "nrlink: UE synchronized on %d.%d (cell %d)\n", h->sfn, h->slot, items.ssb->cell_id);
+      last_abs = abs_slot;
+      continue;
+    }
+
+    int gap = (abs_slot - last_abs + frame_slots) % frame_slots;
+    if (gap == 0 || gap > frame_slots / 2)
+      continue; /* duplicate or old */
+    if (gap > MAX_CATCHUP_SLOTS) {
+      LOG_W(NR_PHY, "nrlink: jumped %d slots\n", gap);
+      gap = 1;
+    }
+    for (int s = gap - 1; s > 0; s--) /* slots whose DL message was lost over the air */
+      process_slot(UE, (abs_slot - s + frame_slots) % frame_slots, NULL);
+    process_slot(UE, abs_slot, &items);
+    last_abs = abs_slot;
+  }
+  return NULL;
+}
