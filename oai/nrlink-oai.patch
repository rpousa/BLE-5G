+/*
+ * nrlink: NR L1 emulation over FRDM-MCXW72 GenFSK boards.
+ *
+ * The gNB PNF (nrlink_gnb.c) and the nrUE (executables/nrlink_ue.c) bypass their PHY and exchange
+ * per-slot "slot messages" with host bridges (~/oai/nrlink/*.py) over UDP. The bridges carry those
+ * messages over the boards' 2.4 GHz radio: gNB bridge -> gNB board ~~air~~ UE board -> UE bridge.
+ *
+ * Slot message: nrlink_hdr_t followed by n_items items, each nrlink_item_t + body (little endian).
+ */
+
+#ifndef NRLINK_PROTO_H
+#define NRLINK_PROTO_H
+
+#include <stdint.h>
+
+#define NRLINK_MAGIC 0x4EU /* 'N' */
+
+/* message types */
+#define NRLINK_MSG_DL_SLOT   1 /* gNB hook -> gNB bridge -> (air) -> UE bridge -> UE emulator */
+#define NRLINK_MSG_UL_SLOT   2 /* UE emulator -> UE bridge -> (air, when polled) -> gNB bridge */
+#define NRLINK_MSG_UL_RESULT 3 /* gNB bridge -> gNB hook: all UL items received for a slot (also the slot ack) */
+#define NRLINK_MSG_HELLO     4 /* UE emulator -> UE bridge: register the emulator's UDP address */
+
+/* DL_SLOT flags */
+#define NRLINK_FLAG_UL_POLL 0x01 /* UL_TTI has PDUs for this slot: the bridge polls the UEs */
+
+/* item types */
+#define NRLINK_IT_SSB     0x01 /* nrlink_ssb_t */
+#define NRLINK_IT_DCI     0x02 /* nrlink_dci_t + payload[(nbits + 7) / 8] */
+#define NRLINK_IT_TB      0x03 /* nrlink_tb_t + data[tb_len] */
+#define NRLINK_IT_ULGRANT 0x04 /* nrlink_ulgrant_t: a PUSCH scheduled in this slot (used for the gNB LEDs) */
+#define NRLINK_IT_PUSCH   0x11 /* nrlink_pusch_t + data[tb_len] */
+#define NRLINK_IT_UCI     0x12 /* nrlink_uci_t */
+#define NRLINK_IT_PRACH   0x13 /* nrlink_prach_t */
+
+typedef struct __attribute__((packed)) {
+  uint8_t magic;
+  uint8_t type;
+  uint16_t sfn;
+  uint8_t slot;
+  uint8_t flags;
+  uint16_t rnti; /* UL_SLOT: the UE's current C-RNTI (0 before RA) */
+  uint16_t n_items;
+} nrlink_hdr_t;
+
+typedef struct __attribute__((packed)) {
+  uint8_t type;
+  uint16_t len; /* body length */
+} nrlink_item_t;
+
+typedef struct __attribute__((packed)) {
+  uint8_t mib[3]; /* as the UE PHY reports it (fapiPbch_t.decoded_output) */
+  uint8_t xtra_byte;
+  uint8_t ssb_index;
+  uint8_t lmax;
+  uint16_t cell_id;
+  uint16_t ssb_start_subcarrier;
+} nrlink_ssb_t;
+
+typedef struct __attribute__((packed)) {
+  uint16_t rnti;
+  uint8_t cce_index;
+  uint8_t aggregation_level;
+  uint8_t nbits;
+  /* payload follows, nFAPI DL_TTI PDCCH Payload byte order */
+} nrlink_dci_t;
+
+typedef struct __attribute__((packed)) {
+  uint16_t rnti;
+  uint16_t tb_len;
+  /* data follows */
+} nrlink_tb_t;
+
+typedef struct __attribute__((packed)) {
+  uint16_t rnti;
+  uint16_t tb_len;
+} nrlink_ulgrant_t;
+
+typedef struct __attribute__((packed)) {
+  uint16_t rnti;
+  uint8_t harq_pid;
+  uint16_t tb_len;
+  /* data follows */
+} nrlink_pusch_t;
+
+typedef struct __attribute__((packed)) {
+  uint16_t rnti;
+  uint8_t format;
+  uint8_t n_harq;
+  uint32_t ack_payload;
+  uint8_t n_sr;
+  uint8_t sr_payload;
+  uint8_t n_bit;     /* format 2/3/4: total UCI bits in payload */
+  uint64_t payload;  /* format 2/3/4: harq | sr << n_harq | csi << (n_harq + n_sr) */
+} nrlink_uci_t;
+
+typedef struct __attribute__((packed)) {
+  uint8_t preamble_index;
+  uint8_t num_ra;
+  uint8_t start_symbol;
+} nrlink_prach_t;
+
+#define NRLINK_MAX_MSG 65000
+
+#endif
